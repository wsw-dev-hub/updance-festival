# Copie para .dev.vars para rodar localmente. Nunca faça commit de .dev.vars.
AMBIENTE=dev
# Chave de /api/admin/setup (tela "Primeiro acesso" em /admin-login/). Use um valor longo e aleatório.
ADMIN_SETUP_KEY=troque-por-uma-chave-longa-e-aleatoria
# Opcional: senha de app do Gmail. Sem ela, em dev o e-mail de "esqueci minha senha" aparece no log do wrangler.
# GMAIL_APP_PASSWORD=
